// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelo de exemplo — apague/renomeie quando começar um projeto de verdade.
// Mantido só para provar que Prisma + migrations estão funcionando de ponta a ponta.
model Item {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("items")
}
